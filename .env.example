# Application
PORT=5000
NODE_ENV=development

# CORS Configuration
CLIENT_URL=http://localhost:3000

# API Versioning
API_PREFIX=/api/v1

# Database (PostgreSQL with Drizzle ORM)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/farmsoko_db

# Authentication (JWT)
JWT_SECRET=supersecret_farmsoko_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_MAX=100
